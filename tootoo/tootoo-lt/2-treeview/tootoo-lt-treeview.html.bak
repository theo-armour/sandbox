<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="revised" content="2026-04-08 16:00">
  <title>TooToo LT</title>
  <style>
    :root {
      --primary-bg: #f3f4f6;
      --secondary-bg: #ffffff;
      --text-color: #1f2937;
      --border-color: #d1d5db;
      --highlight-color: #2563eb;
      --hover-bg: #e5e7eb;
      --font-family: system-ui, -apple-system, sans-serif;
      --sidebar-width: 300px;
      --font-size: 16px;
    }

    html {
      font-size: var(--font-size);
    }

    body.dark-mode {
      --primary-bg: #1f2937;
      --secondary-bg: #111827;
      --text-color: #f3f4f6;
      --border-color: #374151;
      --highlight-color: #3b82f6;
      --hover-bg: #374151;
    }

    * {
      box-sizing: border-box;
    }

    body {
      display: flex;
      flex-direction: column;
      height: 100vh;
      margin: 0;
      overflow-x: hidden;
      font-family: var(--font-family);
      color: var(--text-color);
      background-color: var(--primary-bg);
    }

    header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: var(--primary-bg);
      border-bottom: 1px solid var(--border-color);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
      z-index: 10;
    }

    #headerGitHub {
      display: flex;
      align-items: center;
      color: currentColor;
    }

    #headerTitle {
      font-weight: bold;
      font-size: 1.1rem;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
    }

    main {
      display: flex;
      flex-direction: row;
      flex: 1;
      overflow: hidden;
    }

    .sidebar {
      width: var(--sidebar-width);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      background: var(--primary-bg);
      padding: 0;
      overflow: hidden;
    }

    .resizer {
      width: 8px;
      background: var(--highlight-color);
      opacity: 0.7;
      cursor: col-resize;
      touch-action: none;
      transition: opacity 0.2s;
    }

    .resizer:hover,
    .resizer.dragging {
      opacity: 1;
    }

    .content-area {
      flex: 1;
      min-width: 0;
      padding: 0;
      overflow-y: auto;
      background: var(--secondary-bg);
      position: relative;
    }

    #contentBody {
      padding: 0 1rem 1rem 1rem;
      background: var(--secondary-bg);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0.5rem;
      border-bottom: 1px solid var(--border-color);
      background: var(--primary-bg);
    }

    .panel-header h3 {
      margin: 0;
      font-size: 0.95rem;
    }

    .file-header {
      position: sticky;
      top: 0;
      z-index: 5;
      padding: 0.5rem 1rem;
      background: var(--primary-bg);
    }

    #treeFilter {
      margin: 0.4rem 0.5rem 0 0.5rem;
      width: calc(100% - 1rem);
      box-sizing: border-box;
      padding: 0.3rem 0.5rem;
      font-size: 0.85rem;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      background: var(--secondary-bg);
      color: var(--text-color);
      outline: none;
    }

    #treeFilter:focus {
      border-color: var(--highlight-color);
    }

    #treeList {
      padding: 0 0.5rem;
      flex: 1;
      overflow-y: auto;
    }

    .header-btn {
      background: var(--secondary-bg);
      color: var(--text-color);
      border: 1px solid var(--border-color);
      padding: 0.4rem 0.75rem;
      border-radius: 6px;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
    }

    .header-btn:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    .header-btn:active {
      transform: translateY(0);
    }

    button.primary,
    button.secondary {
      background: var(--highlight-color);
      color: #ffffff;
      border: none;
      padding: 0.4rem 0.75rem;
      border-radius: 6px;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
    }

    button.primary:hover,
    button.secondary:hover {
      opacity: 0.88;
      transform: translateY(-1px);
    }

    button.primary:active,
    button.secondary:active {
      transform: translateY(0);
    }

    .back-to-top {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 20;
      background-color: var(--highlight-color);
      color: #ffffff;
      border: none;
      border-radius: 50%;
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.2rem;
      display: none;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      cursor: pointer;
      align-items: center;
      justify-content: center;
    }

    .rate-limit-badge {
      font-size: 0.8rem;
      opacity: 0.7;
      padding: 0.2rem 0.5rem;
    }

    /* Treeview CSS */
    .tree-folder {
      display: flex;
      align-items: center;
      padding: 0.2rem 0.4rem;
      cursor: pointer;
      border-radius: 4px;
      font-family: monospace;
      font-size: 0.85rem;
      user-select: none;
      list-style: none;
    }

    .tree-folder::-webkit-details-marker { display: none; }

    .tree-folder:hover { background: var(--hover-bg); }

    .tree-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.2rem 0.4rem 0.2rem 1.2rem;
      cursor: pointer;
      border-radius: 4px;
      font-family: monospace;
      font-size: 0.85rem;
    }

    .tree-item:hover { background: var(--hover-bg); }

    .tree-item.active {
      background: var(--highlight-color);
      color: #fff;
    }

    .tree-item-size {
      font-size: 0.75rem;
      opacity: 0.6;
      margin-left: 0.5rem;
      white-space: nowrap;
    }

    details details { padding-left: 0.8rem; }
    details { padding-left: 0; }

    #treeRenderStatus {
      font-size: 0.85rem;
      color: var(--text-color);
      opacity: 0.7;
      padding: 0.3rem 0.5rem;
    }

    @media (max-width: 768px) {
      .sidebar {
        width: 25% !important;
      }

      .resizer {
        width: 4px;
      }

      .file-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
    }
  </style>
</head>

<body>

  <header>
    <a id="headerGitHub" href="#" title="View on GitHub">
      <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
        <path
          d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
      </svg>
    </a>
    <a id="headerTitle" href="#" title="Reload">TooToo LT</a>
    <button id="btnDarkMode" class="header-btn dark-mode-btn" style="margin-left: auto;"
      title="Toggle Dark Mode">🌙</button>
    <button id="btnFontDec" class="header-btn" title="Decrease Font Size">A−</button>
    <button id="btnFontInc" class="header-btn" title="Increase Font Size">A+</button>
    <button id="btnToken" class="header-btn" title="Set GitHub Personal Access Token">⚙️ Token</button>
    <div id="rateBadge" class="rate-limit-badge" style="display: none;" title="API Rate Limit" aria-live="polite"></div>
  </header>

  <main>

    <div class="sidebar">
      <div class="panel-header" title="Last updated: 2026-04-08 16:00">
        <h3 id="hFiles">Files</h3>
        <button id="btnExpandAll" class="secondary" style="display: none;" title="Expand All Folders">Expand
          All</button>
      </div>
      <input type="text" id="treeFilter" placeholder="Filter files…" title="Filter files by name">
      <div id="treeList"></div>
    </div>

    <div class="resizer" id="resizer" title="Drag to Resize Sidebar"></div>

    <div class="content-area" id="contentArea">
      <div class="panel-header file-header">
        <h3 id="contentTitle">Content</h3>
      </div>
      <div id="contentBody">
        <p>Awaiting repository detection...</p>
      </div>
      <button id="btnBackToTop" class="back-to-top" aria-label="Back to top" title="Back to Top">↑</button>
    </div>

  </main>

  <script>

    const escapeHTML = ( str ) => {
      const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
      return String( str ).replace( /[&<>"']/g, ( c ) => map[ c ] );
    };

    const CONFIG = {
      owner: 'theo-armour',
      repo: 'sandbox',
      branch: '',
    };

    const state = {
      owner: '',
      repo: '',
      branch: '',
      tree: null,
      currentFilePath: '',
    };

    const storageKey = ( suffix ) => `tootoo-lt:${ location.pathname }`:${ suffix }`;

    const updateHeaderFromConfig = () => {
      const title = ` / ${ state.repo }`;
      document.title = title;
      document.getElementById( 'headerTitle' ).textContent = title;
      document.getElementById( 'headerGitHub' ).href = `https://github.com/${ encodeURIComponent( state.owner ) }/${ encodeURIComponent( state.repo ) }`;
    };

    const detectRepo = async () => {
      const params = new URLSearchParams( location.search );
      if ( params.get( 'owner' ) ) CONFIG.owner = params.get( 'owner' );
      if ( params.get( 'repo' ) ) CONFIG.repo = params.get( 'repo' );
      if ( params.get( 'branch' ) ) CONFIG.branch = params.get( 'branch' );

      if ( CONFIG.owner && CONFIG.repo ) return;

      const cached = localStorage.getItem( storageKey( 'repo' ) );
      if ( cached ) {
        try {
          const parsed = JSON.parse( cached );
          if ( parsed.owner && parsed.repo ) {
            CONFIG.owner = parsed.owner;
            CONFIG.repo = parsed.repo;
            return;
          }
        } catch ( e ) { /* ignore */ }
      }

      const prefixes = [ '', '../', '../../', '../../../', '../../../../' ];
      for ( const prefix of prefixes ) {
        try {
          const res = await fetch( `.git/config` );
          if ( !res.ok ) continue;
          const text = await res.text();
          const match = text.match( /github\.com[:/]([^/\s]+)\/([^/\s.]+)/ );
          if ( match ) {
            CONFIG.owner = match[ 1 ];
            CONFIG.repo = match[ 2 ].replace( /\.git$/, '' );
            localStorage.setItem( storageKey( 'repo' ), JSON.stringify( { owner: CONFIG.owner, repo: CONFIG.repo } ) );
            return;
          }
        } catch ( e ) { /* ignore */ }
      }

      return new Promise( ( resolve ) => {
        const cb = document.getElementById( 'contentBody' );
        cb.innerHTML = `
          <div style="display: flex; flex-direction: column; gap: 0.5rem; max-width: 300px; margin-top: 1rem;">
            <label>Owner: <input id="inpOwner" style="padding: 0.3rem 0.5rem; width: 100%;" placeholder="e.g. theo-armour"></label>
            <label>Repo: <input id="inpRepo" style="padding: 0.3rem 0.5rem; width: 100%;" placeholder="e.g. sandbox"></label>
            <button id="btnSetRepo" class="primary" title="Set Repository">Set Repository</button>
          </div>
        `;
        document.getElementById( 'btnSetRepo' ).addEventListener( 'click', () => {
          const owner = document.getElementById( 'inpOwner' ).value.trim();
          const repo = document.getElementById( 'inpRepo' ).value.trim();
          if ( owner && repo ) {
            CONFIG.owner = owner;
            CONFIG.repo = repo;
            localStorage.setItem( storageKey( 'repo' ), JSON.stringify( { owner, repo } ) );
            resolve();
          }
        } );
      } );
    };

    const initAppearance = () => {
      if ( localStorage.getItem( storageKey( 'darkMode' ) ) === 'true' ) {
        document.body.classList.add( 'dark-mode' );
        document.getElementById( 'btnDarkMode' ).textContent = '☀️';
      }
      const savedSize = localStorage.getItem( storageKey( 'fontSize' ) );
      if ( savedSize ) {
        document.documentElement.style.setProperty( '--font-size', savedSize );
      }
      const savedWidth = localStorage.getItem( storageKey( 'sidebarWidth' ) );
      if ( savedWidth ) {
        document.documentElement.style.setProperty( '--sidebar-width', savedWidth );
      }
    };

    const setupListeners = () => {
      const btnDark = document.getElementById( 'btnDarkMode' );
      btnDark.addEventListener( 'click', () => {
        document.body.classList.toggle( 'dark-mode' );
        const isDark = document.body.classList.contains( 'dark-mode' );
        btnDark.textContent = isDark ? '☀️' : '🌙';
        localStorage.setItem( storageKey( 'darkMode' ), isDark );
      } );

      const getFontSize = () => parseInt( getComputedStyle( document.documentElement ).getPropertyValue( '--font-size' ) ) || 16;

      document.getElementById( 'btnFontInc' ).addEventListener( 'click', () => {
        const sz = Math.min( getFontSize() + 2, 28 );
        document.documentElement.style.setProperty( '--font-size', sz + 'px' );
        localStorage.setItem( storageKey( 'fontSize' ), sz + 'px' );
      } );

      document.getElementById( 'btnFontDec' ).addEventListener( 'click', () => {
        const sz = Math.max( getFontSize() - 2, 10 );
        document.documentElement.style.setProperty( '--font-size', sz + 'px' );
        localStorage.setItem( storageKey( 'fontSize' ), sz + 'px' );
      } );

      document.getElementById( 'btnToken' ).addEventListener( 'click', () => {
        const current = localStorage.getItem( 'githubToken' ) || '';
        const token = prompt( 'GitHub Personal Access Token:', current );
        if ( token !== null ) {
          localStorage.setItem( 'githubToken', token );
          location.reload();
        }
      } );

      const resizer = document.getElementById( 'resizer' );
      resizer.addEventListener( 'pointerdown', ( e ) => {
        resizer.setPointerCapture( e.pointerId );
        resizer.classList.add( 'dragging' );
        document.body.style.userSelect = 'none';
        document.body.style.cursor = 'col-resize';
      } );

      resizer.addEventListener( 'pointermove', ( e ) => {
        if ( !resizer.hasPointerCapture( e.pointerId ) ) return;
        const w = Math.max( 100, Math.min( e.clientX, window.innerWidth - 100 ) );
        document.documentElement.style.setProperty( '--sidebar-width', w + 'px' );
      } );

      resizer.addEventListener( 'pointerup', ( e ) => {
        resizer.releasePointerCapture( e.pointerId );
        resizer.classList.remove( 'dragging' );
        document.body.style.userSelect = '';
        document.body.style.cursor = '';
        const w = getComputedStyle( document.documentElement ).getPropertyValue( '--sidebar-width' );
        localStorage.setItem( storageKey( 'sidebarWidth' ), w.trim() );
      } );

      const contentArea = document.getElementById( 'contentArea' );
      const btnTop = document.getElementById( 'btnBackToTop' );
      contentArea.addEventListener( 'scroll', () => {
        btnTop.style.display = contentArea.scrollTop > 400 ? 'flex' : 'none';
      } );
      btnTop.addEventListener( 'click', () => {
        contentArea.scrollTo( { top: 0, behavior: 'smooth' } );
      } );

      document.getElementById( 'headerTitle' ).addEventListener( 'click', ( e ) => {
        e.preventDefault();
        location.reload();
      } );
    };

    /* -- Treeview -- */

    let fetchController = null;

    const getAuthHeaders = () => {
      const token = localStorage.getItem( 'githubToken' );
      const headers = { Accept: 'application/vnd.github+json' };
      if ( token ) headers.Authorization = `token ${ token }`;
      return headers;
    };

    const updateRateBadge = ( response ) => {
      const remaining = response.headers.get( 'X-RateLimit-Remaining' );
      const limit = response.headers.get( 'X-RateLimit-Limit' );
      if ( remaining && limit ) {
        const badge = document.getElementById( 'rateBadge' );
        badge.style.display = 'inline';
        badge.textContent = `/${ limit }`;
      }
    };

    const fileIcon = ( name ) => {
      const ext = name.includes( '.' ) ? '.' + name.split( '.' ).pop().toLowerCase() : '';
      const icons = {
        '.md': '📝',
        '.js': '🟨', '.mjs': '🟨', '.cjs': '🟨',
        '.ts': '🟦', '.tsx': '🟦',
        '.py': '🐍',
        '.html': '🌐', '.htm': '🌐',
        '.css': '🎨', '.scss': '🎨', '.less': '🎨',
        '.png': '🖼️', '.jpg': '🖼️', '.jpeg': '🖼️', '.gif': '🖼️', '.webp': '🖼️', '.svg': '🖼️', '.ico': '🖼️',
        '.mp3': '🎵', '.wav': '🎵', '.ogg': '🎵',
        '.mp4': '🎬', '.webm': '🎬',
        '.pdf': '📕',
        '.xlsx': '📊', '.xls': '📊', '.csv': '📊', '.ods': '📊',
        '.yaml': '⚙️', '.yml': '⚙️', '.toml': '⚙️',
        '.zip': '📦', '.tar': '📦', '.gz': '📦', '.7z': '📦',
        '.json': '{ }',
      };
      return icons[ ext ] ?? '📄';
    };

    const formatSize = ( bytes ) => {
      if ( bytes < 1024 ) return ` B`;
      if ( bytes < 1024 * 1024 ) return ` KB`;
      return ` MB`;
    };

    const buildNestedTree = ( flatTree ) => {
      const root = { children: {} };
      for ( const item of flatTree ) {
        const parts = item.path.split( '/' );
        if ( parts.some( ( p ) => p.startsWith( '.' ) ) ) continue;
        let node = root;
        for ( let i = 0; i < parts.length; i++ ) {
          const name = parts[ i ];
          if ( !node.children[ name ] ) {
            node.children[ name ] = { children: {}, type: 'tree', path: parts.slice( 0, i + 1 ).join( '/' ) };
          }
          if ( i === parts.length - 1 ) {
            node.children[ name ].type = item.type;
            node.children[ name ].size = item.size;
            node.children[ name ].path = item.path;
          }
          node = node.children[ name ];
        }
      }
      return root;
    };

    const sortedEntries = ( children ) => {
      const entries = Object.entries( children );
      const folders = entries.filter( ( [ , v ] ) => v.type === 'tree' || Object.keys( v.children ).length > 0 );
      const files = entries.filter( ( [ , v ] ) => v.type === 'blob' && Object.keys( v.children ).length === 0 );
      const sorter = ( a, b ) => a[ 0 ].localeCompare( b[ 0 ], undefined, { sensitivity: 'base' } );
      folders.sort( sorter );
      files.sort( sorter );
      return [ ...folders, ...files ];
    };

    const renderNode = ( name, node ) => {
      const isFolder = node.type === 'tree' || Object.keys( node.children ).length > 0;
      if ( isFolder ) {
        const escapedName = escapeHTML( name );
        const escapedPath = escapeHTML( node.path );
        let inner = `<details data-folder-path="${ escapedPath }">`
        inner += `<summary class="tree-folder" tabindex="0" title="${ escapedPath }">📁 <span class="folder-name">${ escapedName }</span></summary>`;
        for ( const [ childName, childNode ] of sortedEntries( node.children ) ) {
          inner += renderNode( childName, childNode );
        }
        inner += '</details>';
        return inner;
      }
      const escapedName = escapeHTML( name );
      const escapedPath = escapeHTML( node.path );
      const icon = fileIcon( name );
      const size = node.size != null ? formatSize( node.size ) : '';
      const isReadme = /^readme/i.test( name );
      const nameHtml = isReadme ? `<strong>${ escapedName }</strong>` : escapedName;
      return `<div class="tree-item" tabindex="0" data-action="select-file" data-path="${ escapedPath }" title="${ escapedPath }"><span class="tree-item-name">${ icon } ${ nameHtml }</span><span class="tree-item-size">${ escapeHTML( size ) }</span></div>`;
    };

    const renderTree = ( treeArray ) => {
      const treeList = document.getElementById( 'treeList' );
      const nested = buildNestedTree( treeArray );
      const rootEntries = sortedEntries( nested.children );
      const batchSize = 120;
      const total = rootEntries.length;
      let rendered = 0;

      treeList.innerHTML = '';
      const status = document.createElement( 'div' );
      status.id = 'treeRenderStatus';
      status.textContent = '0% rendered…';
      treeList.appendChild( status );

      const renderBatch = () => {
        const end = Math.min( rendered + batchSize, total );
        let html = '';
        for ( let i = rendered; i < end; i++ ) {
          const [ name, node ] = rootEntries[ i ];
          html += renderNode( name, node );
        }
        status.insertAdjacentHTML( 'beforebegin', html );
        rendered = end;
        const pct = Math.round( ( rendered / total ) * 100 );
        status.textContent = `% rendered…`;

        if ( rendered < total ) {
          setTimeout( renderBatch, 0 );
        } else {
          status.remove();
          onTreeRenderComplete();
        }
      };

      if ( total === 0 ) {
        status.textContent = 'No files found.';
        return;
      }

      renderBatch();
    };

    const onTreeRenderComplete = () => {
      document.getElementById( 'btnExpandAll' ).style.display = '';

      if ( state.tree ) {
        const readme = state.tree.find( ( item ) =>
          item.type === 'blob' && /^readme\.(md|txt)$/i.test( item.path.split( '/' ).pop() ) && !item.path.includes( '/' )
        ) ?? state.tree.find( ( item ) =>
          item.type === 'blob' && /^readme\.(md|txt)$/i.test( item.path.split( '/' ).pop() )
        );
        if ( readme ) {
          selectFile( readme.path );
        }
      }

      setupFilterListener();
      setupKeyboardNav();
      setupSlashShortcut();
    };

    const selectFile = ( filePath ) => {
      const treeList = document.getElementById( 'treeList' );
      const prev = treeList.querySelector( '.tree-item.active' );
      if ( prev ) prev.classList.remove( 'active' );

      const el = treeList.querySelector( `[data-action="select-file"][data-path="${ CSS.escape( filePath ) }"]` );
      if ( el ) {
        el.classList.add( 'active' );
        el.focus();
      }

      state.currentFilePath = filePath;
      const fileName = filePath.split( '/' ).pop();
      document.getElementById( 'contentTitle' ).textContent = escapeHTML( fileName );
      document.getElementById( 'contentBody' ).innerHTML = `<p>Selected: ${ escapeHTML( filePath ) }</p>`;
    };

    const scrollToTreeFolder = ( folderPath ) => {
      const el = document.querySelector( `details[data-folder-path="${ CSS.escape( folderPath ) }"]` );
      if ( !el ) return;
      let parent = el.parentElement?.closest( 'details' );
      while ( parent ) {
        parent.open = true;
        parent = parent.parentElement?.closest( 'details' );
      }
      el.open = true;
      el.scrollIntoView( { block: 'center', behavior: 'smooth' } );
    };

    const setupExpandAll = () => {
      const btn = document.getElementById( 'btnExpandAll' );
      btn.addEventListener( 'click', () => {
        const allDetails = document.getElementById( 'treeList' ).querySelectorAll( 'details' );
        const expanding = btn.textContent.trim() === 'Expand All';
        allDetails.forEach( ( d ) => { d.open = expanding; } );
        btn.textContent = expanding ? 'Collapse All' : 'Expand All';
        btn.title = expanding ? 'Collapse All Folders' : 'Expand All Folders';
      } );
    };

    const setupFileSelection = () => {
      document.getElementById( 'treeList' ).addEventListener( 'click', ( e ) => {
        const target = e.target.closest( '[data-action="select-file"]' );
        if ( !target ) return;
        selectFile( target.dataset.path );
      } );
    };

    const setupFilterListener = () => {
      const input = document.getElementById( 'treeFilter' );
      let timer = null;
      input.addEventListener( 'input', () => {
        clearTimeout( timer );
        timer = setTimeout( () => {
          const query = input.value.trim().toLowerCase();
          const treeList = document.getElementById( 'treeList' );
          const items = treeList.querySelectorAll( '.tree-item' );
          const details = treeList.querySelectorAll( 'details' );

          if ( !query ) {
            items.forEach( ( el ) => { el.style.display = ''; } );
            details.forEach( ( el ) => { el.style.display = ''; el.open = false; } );
            return;
          }

          items.forEach( ( el ) => {
            const path = ( el.dataset.path || '' ).toLowerCase();
            el.style.display = path.includes( query ) ? '' : 'none';
          } );

          details.forEach( ( el ) => {
            const hasVisible = el.querySelector( '.tree-item:not([style*="display: none"])' );
            el.style.display = hasVisible ? '' : 'none';
            if ( hasVisible ) el.open = true;
          } );
        }, 150 );
      } );
    };

    const getVisibleTreeItems = () => {
      const treeList = document.getElementById( 'treeList' );
      const all = [ ...treeList.querySelectorAll( '.tree-folder, .tree-item' ) ];
      return all.filter( ( el ) => {
        if ( el.style.display === 'none' ) return false;
        let parent = el.parentElement;
        while ( parent && parent.id !== 'treeList' ) {
          if ( parent.tagName === 'DETAILS' && !parent.open && parent.querySelector( 'summary' ) !== el ) {
            return false;
          }
          parent = parent.parentElement;
        }
        return true;
      } );
    };

    const setupKeyboardNav = () => {
      document.addEventListener( 'keydown', ( e ) => {
        const active = document.activeElement;
        if ( !active ) return;
        const inTree = active.closest( '#treeList' ) && ( active.classList.contains( 'tree-folder' ) || active.classList.contains( 'tree-item' ) );
        if ( !inTree ) return;

        const items = getVisibleTreeItems();
        const idx = items.indexOf( active );
        if ( idx === -1 ) return;

        const handle = ( action ) => {
          e.preventDefault();
          action();
        };

        if ( e.key === 'ArrowDown' ) {
          handle( () => {
            if ( idx < items.length - 1 ) {
              const next = items[ idx + 1 ];
              next.focus();
              if ( next.classList.contains( 'tree-item' ) ) selectFile( next.dataset.path );
            }
          } );
        } else if ( e.key === 'ArrowUp' ) {
          handle( () => {
            if ( idx > 0 ) {
              const prev = items[ idx - 1 ];
              prev.focus();
              if ( prev.classList.contains( 'tree-item' ) ) selectFile( prev.dataset.path );
            }
          } );
        } else if ( e.key === 'Enter' || e.key === ' ' ) {
          handle( () => {
            if ( active.classList.contains( 'tree-folder' ) ) {
              const details = active.closest( 'details' );
              if ( details ) details.open = !details.open;
            } else if ( active.classList.contains( 'tree-item' ) ) {
              selectFile( active.dataset.path );
            }
          } );
        } else if ( e.key === 'ArrowRight' ) {
          handle( () => {
            if ( active.classList.contains( 'tree-folder' ) ) {
              const details = active.closest( 'details' );
              if ( details && !details.open ) {
                details.open = true;
              } else if ( details && details.open ) {
                const firstChild = details.querySelector( '.tree-folder, .tree-item' );
                if ( firstChild && firstChild !== active ) firstChild.focus();
              }
            }
          } );
        } else if ( e.key === 'ArrowLeft' ) {
          handle( () => {
            if ( active.classList.contains( 'tree-folder' ) ) {
              const details = active.closest( 'details' );
              if ( details?.open ) {
                details.open = false;
              } else {
                const parentDetails = details?.parentElement?.closest( 'details' );
                if ( parentDetails ) parentDetails.querySelector( 'summary' )?.focus();
              }
            } else {
              const parentDetails = active.closest( 'details' );
              if ( parentDetails ) parentDetails.querySelector( 'summary' )?.focus();
            }
          } );
        }
      } );
    };

    const setupSlashShortcut = () => {
      document.addEventListener( 'keydown', ( e ) => {
        if ( e.key === '/' && !( document.activeElement?.tagName === 'INPUT' || document.activeElement?.tagName === 'TEXTAREA' ) ) {
          e.preventDefault();
          document.getElementById( 'treeFilter' ).focus();
        }
      } );
    };

    const fetchTree = async () => {
      if ( fetchController ) fetchController.abort();
      fetchController = new AbortController();
      const signal = fetchController.signal;
      const headers = getAuthHeaders();
      const treeList = document.getElementById( 'treeList' );

      try {
        if ( !state.branch ) {
          const repoRes = await fetch(
            `https://api.github.com/repos/${ encodeURIComponent( state.owner ) }/${ encodeURIComponent( state.repo ) }`,
            { headers, signal }
          );
          updateRateBadge( repoRes );
          if ( !repoRes.ok ) throw new Error( `Repo fetch failed: ${ repoRes.status }` );
          const repoData = await repoRes.json();
          state.branch = repoData.default_branch;
        }

        treeList.innerHTML = '<p>Loading tree…</p>';

        const treeRes = await fetch(
          `https://api.github.com/repos/${ encodeURIComponent( state.owner ) }/${ encodeURIComponent( state.repo ) }/git/trees/${ encodeURIComponent( state.branch ) }?recursive=1`,
          { headers, signal }
        );
        updateRateBadge( treeRes );

        if ( treeRes.status === 403 ) {
          treeList.innerHTML = '<p style="color: red;">Rate limited. Add a GitHub token for higher limits.</p>';
          return;
        }
        if ( !treeRes.ok ) throw new Error( `Tree fetch failed: ${ treeRes.status }` );

        const treeData = await treeRes.json();

        if ( treeData.truncated ) {
          treeList.innerHTML = '';
          const warning = document.createElement( 'div' );
          warning.style.cssText = 'background: #fff3cd; border: 1px solid #ffc107; padding: 0.5rem; border-radius: 4px; margin-bottom: 0.5rem; font-size: 0.85rem;';
          warning.textContent = '⚠️ Repository tree is truncated. Some files may not appear.';
          treeList.appendChild( warning );
        }

        state.tree = treeData.tree;
        renderTree( state.tree );

      } catch ( err ) {
        if ( err.name === 'AbortError' ) return;
        treeList.innerHTML = `<p style="color: red;">${ escapeHTML( err.message ) }</p>`;
      }
    };

    const init = async () => {
      initAppearance();
      setupListeners();
      setupExpandAll();
      setupFileSelection();
      await detectRepo();
      state.owner = CONFIG.owner;
      state.repo = CONFIG.repo;
      state.branch = CONFIG.branch;
      if ( state.owner && state.repo ) {
        updateHeaderFromConfig();
        await fetchTree();
      }
    };

    init();

  </script>
</body>

</html>
