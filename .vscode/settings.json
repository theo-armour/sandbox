{
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.rulers": [
    80
  ],
  "editor.renderWhitespace": "boundary",
  "editor.inlineSuggest.enabled": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "html.format.wrapLineLength": 0,
  "markdownlint.config": {
    "MD022": false,
    "MD032": false
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": true
  }
}
